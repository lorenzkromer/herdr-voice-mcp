{
  "name": "herdr-voice-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for voice-driven control of Herdr coding agents: status, stand-ups, prompts and push notifications from the Claude app on your phone.",
  "type": "module",
  "bin": {
    "herdr-voice-mcp": "dist/server.js",
    "herdr-voice-notify": "dist/notify.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "dev:notify": "tsx src/notify.ts",
    "start": "node dist/server.js",
    "start:notify": "node dist/notify.js",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorenzkromer/herdr-voice-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "herdr",
    "claude",
    "coding-agents",
    "voice"
  ],
  "files": [
    "dist",
    "config.example.json",
    "launchd",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
